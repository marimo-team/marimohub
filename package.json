{
	"name": "marimohub",
	"version": "0.3.6",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev-ports.mjs",
		"dev:reset": "node scripts/reset-dev-storage.mjs",
		"dev:services": "docker compose -f scripts/dev-services/compose.yaml up -d",
		"dev:services:down": "docker compose -f scripts/dev-services/compose.yaml down",
		"ready": "vp fmt && vp lint && pnpm typecheck && vp run -r test && vp run -r build",
		"check": "vp check",
		"typecheck": "vp run -r typecheck",
		"test": "vp test tools/oxlint/anti-slop/index.test.ts && vp run -r test --configLoader=runner --pool=threads",
		"test:coverage": "pnpm test:coverage:root && pnpm test:coverage:web",
		"test:coverage:root": "vp test --coverage",
		"test:coverage:web": "pnpm --filter @marimo-hub/web test --coverage",
		"audit:prod": "node scripts/audit-production.mjs",
		"e2e": "pnpm --filter @marimo-hub/e2e e2e",
		"schemas:generate": "pnpm --filter @marimo-hub/api openapi:generate && pnpm --filter @marimo-hub/api cli:generate && pnpm --filter @marimo-hub/core schemas:generate && vp fmt internal/schemas && pnpm --filter @marimo-hub/client generate && pnpm --filter @marimo-hub/docs integrations:generate",
		"build": "vp run -r build",
		"cli:version-check": "node scripts/check-cli-version.mjs",
		"release": "node scripts/release.mjs",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@oxlint/plugins": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"oxlint": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@10.34.5",
	"pnpm": {
		"overrides": {
			"brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
			"hono": "4.12.34",
			"ip-address@<=10.3.0": "10.3.1",
			"js-yaml@<4.0.0": "3.15.1",
			"js-yaml@>=4.0.0 <4.3.1": "4.3.1",
			"linkify-it@<=5.0.1": "5.0.2",
			"nanoid": "3.3.18",
			"postcss@<=8.5.22": "8.5.23",
			"protobufjs@>=7.5.0 <=7.6.4": "7.6.5",
			"shell-quote@<=1.8.4": "1.9.0",
			"tar": "7.5.21",
			"undici@>=7.0.0 <7.29.0": "^7.29.0",
			"vitepress>vite": "^6.4.3"
		}
	}
}
