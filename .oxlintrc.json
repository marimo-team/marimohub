{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "typescript", "react-perf"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"eslint/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"react/react-in-jsx-scope": "off"
	},
	"env": {
		"builtin": true,
		"browser": true
	},
	"ignorePatterns": ["dist", "node_modules"]
}
