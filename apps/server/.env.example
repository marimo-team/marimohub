# marimohub server configuration (prefix: MARIMOHUB_)

# --- Storage (object store is the single source of truth) ---
MARIMOHUB_STORAGE_BACKEND=s3                 # s3 | gcs | azure | fs | memory
MARIMOHUB_ALLOW_EPHEMERAL_STORAGE=false      # set true ONLY for the non-durable memory backend (dev/tests)
MARIMOHUB_STORAGE_S3_BUCKET=orgname-marimohub
MARIMOHUB_STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com   # MinIO/Tigris/R2: their endpoint
MARIMOHUB_STORAGE_S3_REGION=us-east-1
MARIMOHUB_STORAGE_S3_ACCESS_KEY_ID=          # secret
MARIMOHUB_STORAGE_S3_SECRET_ACCESS_KEY=      # secret
MARIMOHUB_STORAGE_S3_FORCE_PATH_STYLE=false  # true for MinIO/Ceph
# Azure Blob Storage (use DefaultAzureCredential unless a connection string is set):
# MARIMOHUB_STORAGE_AZURE_CONTAINER=orgname-marimohub
# MARIMOHUB_STORAGE_AZURE_ACCOUNT_URL=https://account.blob.core.windows.net
# MARIMOHUB_STORAGE_AZURE_CONNECTION_STRING=  # secret; optional local/legacy fallback

# --- Compute (kernel sandboxes) ---
MARIMOHUB_COMPUTE_BACKEND=modal              # required: modal | coreweave | wandb | kubernetes | docker | e2b | local | none
MARIMOHUB_COMPUTE_IMAGE=                     # sandbox image (marimo + uv + python)
MARIMOHUB_COMPUTE_PROFILES=                  # example: small:cpu=1;mem=2Gi,gpu-large:cpu=8;mem=32Gi;gpu=A100:2
MARIMOHUB_COMPUTE_PROFILE_OVERRIDE=none      # none | editors
MARIMOHUB_COMPUTE_SANDBOX_HOSTNAME=          # public hostname for exposed kernel ports
MARIMOHUB_COMPUTE_IDLE_TIMEOUT=20m
MARIMOHUB_COMPUTE_MODAL_TOKEN_ID=            # secret
MARIMOHUB_COMPUTE_MODAL_TOKEN_SECRET=        # secret
# MARIMOHUB_COMPUTE_MODAL_APP_NAME=marimohub # scopes reconciler enumeration to this app's sandboxes
# coreweave backend (CoreWeave Sandboxes via the vendored @coreweave/cwsandbox SDK; Node/gRPC):
# MARIMOHUB_COMPUTE_COREWEAVE_API_KEY=         # secret (CWSANDBOX_API_KEY)
# MARIMOHUB_COMPUTE_COREWEAVE_BASE_URL=        # optional API base (default https://api.cwsandbox.com)
# MARIMOHUB_COMPUTE_COREWEAVE_OWNER_TAG=marimohub  # tag applied to owned sandboxes (discovery/cleanup)
# MARIMOHUB_COMPUTE_COREWEAVE_HOSTNAME_TEMPLATE=https://{sandboxId}-{port}.{host}  # public kernel URL scheme
# MARIMOHUB_COMPUTE_COREWEAVE_MAX_LIFETIME_SECONDS=  # hard lifetime cap (orphan protection; no listActive)
# MARIMOHUB_COMPUTE_COREWEAVE_OBJECT_STORAGE_BUCKETS=  # sandbox-native CAIOS creds (disables MARIMOHUB_WIF_*; see docs/workload-identity-federation.md)
# wandb backend (CoreWeave Sandboxes via the W&B gateway; same adapter as coreweave, W&B API key auth.
# Kernel URLs auto-resolve to per-sandbox public IPs (plain HTTP) — no SANDBOX_HOSTNAME needed.
# No GPU/egress overrides or CAIOS vending through the gateway — use MARIMOHUB_WIF_* for bucket access):
# MARIMOHUB_COMPUTE_WANDB_API_KEY=             # secret (WANDB_API_KEY, from wandb.ai user settings)
# MARIMOHUB_COMPUTE_WANDB_ENTITY=              # optional W&B entity (team/user) sandboxes are attributed to
# MARIMOHUB_COMPUTE_WANDB_PROJECT=             # optional W&B project sandboxes are attributed to
# MARIMOHUB_COMPUTE_WANDB_BASE_URL=            # optional gateway override (default https://api.cwsandbox.com)
# MARIMOHUB_COMPUTE_WANDB_OWNER_TAG=marimohub  # tag applied to owned sandboxes (discovery/cleanup)
# MARIMOHUB_COMPUTE_WANDB_MAX_LIFETIME_SECONDS=  # hard lifetime cap (orphan protection; no listActive)
# kubernetes backend (native Pod + Service + Ingress per session via @kubernetes/client-node,
# a bring-your-own dep — `pnpm add @kubernetes/client-node` and bake it into the image).
# Set MARIMOHUB_COMPUTE_SANDBOX_HOSTNAME (kernels served at https://<id>.<host>) and an ingress class + TLS.
# MARIMOHUB_COMPUTE_KUBERNETES_NAMESPACE=marimo-kernels   # namespace for kernel pods (default: default)
# MARIMOHUB_COMPUTE_KUBERNETES_HOSTNAME_TEMPLATE=https://{id}.{host}  # public kernel URL scheme
# MARIMOHUB_COMPUTE_KUBERNETES_INGRESS_CLASS=traefik      # ingressClassName for the per-session Ingress
# MARIMOHUB_COMPUTE_KUBERNETES_INGRESS_ANNOTATIONS={"route.openshift.io/termination":"edge"}  # JSON string map
# MARIMOHUB_COMPUTE_KUBERNETES_INGRESS_TLS_MODE=controller-default  # disabled | controller-default (`default` alias) | secret
# MARIMOHUB_COMPUTE_KUBERNETES_TLS_SECRET=                # wildcard-cert secret for *.{host}
# MARIMOHUB_COMPUTE_KUBERNETES_SERVICE_ACCOUNT=           # ServiceAccount the kernel pod runs as
# MARIMOHUB_COMPUTE_KUBERNETES_IMAGE_PULL_SECRET=         # imagePullSecrets name for a private image
# MARIMOHUB_COMPUTE_KUBERNETES_CPU=     MARIMOHUB_COMPUTE_KUBERNETES_MEMORY=     MARIMOHUB_COMPUTE_KUBERNETES_GPU=
# MARIMOHUB_COMPUTE_KUBERNETES_POD_READY_TIMEOUT_SECONDS=120  # wait for the kernel pod to be Running
# local backend (dev only): runs `uv run marimo edit` as a host subprocess and
# serves the kernel at http://<host>:<port>. Requires `uv` + Python on the host.
# Only works when the server runs on the host (e.g. `pnpm dev`), not in a container.
# MARIMOHUB_COMPUTE_LOCAL_HOST=localhost     # host the exposed kernel URL points at
# MARIMOHUB_COMPUTE_LOCAL_BIND_HOST=127.0.0.1  # local backend: address the kernel binds (0.0.0.0 in Docker)
# MARIMOHUB_COMPUTE_LOCAL_PORTS=2718-2723      # local backend: published port range

# --- Sandbox exposure (how kernels reach the browser; agnostic of compute backend) ---
MARIMOHUB_SANDBOX_EXPOSURE=subdomain         # subdomain (direct, isolated domain) | proxy (through the app)
# proxy mode forwards kernel traffic through the app (authenticated + per-session authorized)
# but serves untrusted code same-origin (XSS-capable) — trusted deployments only:
# MARIMOHUB_SANDBOX_PROXY_ACK_UNTRUSTED=true  # required to enable proxy mode (fails closed)
# MARIMOHUB_APP_BASE_URL=https://hub.example.com  # optional; else derived from the request

# --- Authentication (app-native OIDC) ---
MARIMOHUB_AUTH_BACKEND=oidc                  # oidc | dev
MARIMOHUB_AUTH_OIDC_ISSUER=https://accounts.example.com
MARIMOHUB_AUTH_OIDC_CLIENT_ID=
MARIMOHUB_AUTH_OIDC_CLIENT_SECRET=           # secret
MARIMOHUB_AUTH_OIDC_AUDIENCE=
MARIMOHUB_AUTH_OIDC_REDIRECT_URI=https://hub.example.com/api/auth/callback
MARIMOHUB_AUTH_SESSION_SECRET=               # secret — signs the session cookie
MARIMOHUB_AUTH_ALLOWED_EMAIL_DOMAINS=example.com  # REQUIRED (oidc): comma-separated allowlist; restrict login to these email domains (requires verified email). Set `*` to explicitly allow all. A single domain is also sent to Google as the `hd` hint.
# dev bypass (local only):
# MARIMOHUB_AUTH_DEV_USER_ID=user
# MARIMOHUB_AUTH_DEV_EMAIL=user@localhost

# --- Server ---
PORT=3000
MARIMOHUB_STATIC_ROOT=./public               # prebuilt SPA assets
# MARIMOHUB_EXPERIMENTS=duckdb-wasm-preview,duckdb-wasm-sql
MARIMOHUB_RUN_MAINTENANCE=true               # run session-maintenance cron on THIS replica only
MARIMOHUB_MAX_SESSIONS_PER_USER=10           # per-user concurrent session cap (0 = unlimited)
# MARIMOHUB_EDITOR_SANDBOX_SHARING=shared     # shared: all editors attach to one sandbox
#                                              # exclusive: one owner, temporary sandboxes, and takeover
# MARIMOHUB_ALLOWED_ORIGINS=                 # comma-separated extra Origins allowed for state-changing requests (CSRF)
# MARIMOHUB_DEFAULT_ROLE=editor              # fallback role for logged-in non-members (viewer|editor|manager|none); default editor.
#                                            #   editor: everyone can edit any project | viewer: everyone can view any project
#                                            #   none:   non-members can't even see projects they don't belong to (but can create their own)
#                                            # Project edit/delete always requires manager.
# MARIMOHUB_SUPER_ADMINS=admin@example.com   # comma-separated operator emails/ids; can administer all projects and suspend users
# MARIMOHUB_VERSION=dev                       # deploy version (git SHA / tag) shown in the UI footer; usually baked in at build time
# MARIMOHUB_IMAGE=                            # docker image ref (repo:tag) shown in the UI footer; usually baked in at build time

# --- Integrations and data browser (optional) ---
# MARIMOHUB_INTEGRATIONS=off                  # on by default; off disables routes and session injection
# MARIMOHUB_DATA_BROWSER=full                 # off | metadata | full
# MARIMOHUB_DATA_QUERY_MAX_CONCURRENT=4
# MARIMOHUB_DATA_QUERY_MAX_CONCURRENT_PER_USER=1
# MARIMOHUB_DATA_QUERY_MAX_ROWS=10000
# MARIMOHUB_DATA_QUERY_MAX_BYTES=2097152
# MARIMOHUB_DATA_QUERY_TIMEOUT_SECONDS=30
# MARIMOHUB_DATA_QUERY_MEMORY_LIMIT_MB=128

# --- Notifications (optional; leave BACKENDS empty to disable all delivery) ---
# MARIMOHUB_PROJECT_ALERTS=off               # on enables project Slack/webhook alerts (requires MARIMOHUB_SECRETS_KEK)
# MARIMOHUB_NOTIFY_BACKENDS=smtp,slack,webhook
# MARIMOHUB_NOTIFY_KINDS=member.invited,member.added,session.takeover  # default allowlist; none overrides channel values
# MARIMOHUB_NOTIFY_SMTP_URL=smtps://user:password@smtp.example.com:465  # secret
# MARIMOHUB_NOTIFY_SMTP_FROM=marimohub <hub@example.com>
# MARIMOHUB_NOTIFY_SMTP_ADMIN_TO=platform@example.com,security@example.com
# MARIMOHUB_NOTIFY_SMTP_KINDS=member.invited,member.added  # optional; inherits MARIMOHUB_NOTIFY_KINDS
# MARIMOHUB_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/secret  # secret
# MARIMOHUB_NOTIFY_SLACK_KINDS=session.takeover  # optional; broadcast variants only
# MARIMOHUB_NOTIFY_WEBHOOK_URL=https://events.example.com/marimohub  # secret when the path contains a token
# MARIMOHUB_NOTIFY_WEBHOOK_SECRET=             # secret; HMAC-SHA256 signing key
# MARIMOHUB_NOTIFY_WEBHOOK_KINDS=session.takeover  # optional; inherits MARIMOHUB_NOTIFY_KINDS

# --- Workload Identity Federation (optional): notebook access to an object-storage
#     bucket with NO long-lived key. Deployment-wide capability; each project opts in
#     via its `federation` setting. All-or-nothing on the generic vars.
#     See docs/coreweave-bucket-access.md for the cloud-side setup.
# MARIMOHUB_WIF_SIGNING_KEY=                  # secret — RSA private key (PKCS8 PEM); its public JWKS is published at /.well-known/jwks.json
# MARIMOHUB_WIF_KID=wif-2026-06               # key id in the JWT header + JWKS
# MARIMOHUB_WIF_ISSUER_URL=https://hub.example.com   # token `iss` + OIDC discovery issuer (must match the cloud WIF config)
# MARIMOHUB_WIF_AUDIENCE=coreweave-object-storage    # token `aud` (must match the cloud WIF config Client ID/Audience)
# MARIMOHUB_WIF_STORAGE_ENDPOINT=https://cwobject.com   # injected as AWS_ENDPOINT_URL_S3; set for a non-AWS store (omit for AWS), no fallback
# MARIMOHUB_WIF_STORAGE_REGION=us-east-1                # injected as AWS_REGION; set explicitly, no fallback
# MARIMOHUB_WIF_TARGET_NAME=default           # name projects select via federation.target (default: default)
# MARIMOHUB_WIF_BROKER=coreweave              # REQUIRED when WIF enabled — credential broker (supported: coreweave)
# MARIMOHUB_WIF_COREWEAVE_EXCHANGE_URL=https://api.coreweave.com/v1/cwobject/temporary-credentials/oidc/<ORG-ID>  # required when broker=coreweave (NOT the oidc.cks issuer URL)

# --- Integration secret sources (optional). Inline values require the KEK.
#     External references resolve only when testing an integration or starting a
#     session, and failures block the operation. See docs/integration-secrets.md.
# MARIMOHUB_SECRETS_KEK=                      # secret — generated 32-byte base64 or hex key for inline encrypted integration values
# MARIMOHUB_SECRETS_KEK_ID=                   # optional label stamped on encrypted envelopes
#     AWS Secrets Manager reference source (backend=aws-sm):
# MARIMOHUB_SECRETS_AWS_REGION=us-east-1      # AWS region; enables aws-sm. Credentials default to the AWS chain (IRSA/role/ambient).
# MARIMOHUB_SECRETS_AWS=true                  # enable aws-sm without a region env var (region from ambient config)
# MARIMOHUB_SECRETS_AWS_ACCESS_KEY_ID=        # secret — static-credential override for non-AWS hosts (all-or-nothing with the secret key)
# MARIMOHUB_SECRETS_AWS_SECRET_ACCESS_KEY=    # secret — paired with the access key id
# MARIMOHUB_SECRETS_AWS_CACHE_TTL_SECONDS=0   # in-memory resolve cache TTL; 0 disables
