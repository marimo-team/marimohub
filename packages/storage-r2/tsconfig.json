{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"types": ["node", "@cloudflare/workers-types"],
		"strict": true,
		"declaration": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"skipLibCheck": true
	},
	"include": ["src"]
}
