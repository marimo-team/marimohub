{
	"name": "@marimo-hub/client",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp run test:vitest",
		"check": "vp check",
		"generate": "openapi-typescript ../api/openapi.yaml -o ./src/schema.ts && vp fmt src/schema.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"openapi-fetch": "catalog:"
	},
	"devDependencies": {
		"@marimo-hub/tsconfig": "workspace:*",
		"@marimo-hub/vite-config": "workspace:*",
		"@types/node": "catalog:",
		"openapi-typescript": "7.13.0",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
