{
	"family": "marimohub-kernel",
	"taskRoleArn": "arn:aws:iam::123456789012:role/marimohub-kernel-task",
	"executionRoleArn": "arn:aws:iam::123456789012:role/marimohub-kernel-execution",
	"networkMode": "awsvpc",
	"requiresCompatibilities": ["FARGATE"],
	"cpu": "1024",
	"memory": "4096",
	"containerDefinitions": [
		{
			"name": "marimo",
			"image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/marimo-sandbox:py3.13-marimo0.24.0",
			"essential": true,
			"user": "1000:1000",
			"workingDirectory": "/workspace",
			"command": ["/usr/local/bin/marimohub-fargate-agent"],
			"environment": [{ "name": "MARIMOHUB_AGENT_PORT", "value": "2717" }],
			"portMappings": [
				{ "name": "agent", "containerPort": 2717, "protocol": "tcp" },
				{ "name": "marimo", "containerPort": 2718, "protocol": "tcp" },
				{ "name": "opencode", "containerPort": 4096, "protocol": "tcp" },
				{ "name": "vscode", "containerPort": 8443, "protocol": "tcp" }
			],
			"logConfiguration": {
				"logDriver": "awslogs",
				"options": {
					"awslogs-group": "/marimohub/kernels",
					"awslogs-region": "us-east-1",
					"awslogs-stream-prefix": "fargate"
				}
			},
			"stopTimeout": 30
		}
	],
	"tags": [
		{ "key": "managed-by", "value": "marimohub" },
		{ "key": "purpose", "value": "notebook-kernel" }
	]
}
