# marimohub — CoreWeave: CAIOS object storage (S3 API) + CoreWeave Sandboxes +
# OIDC login + Workload Identity Federation (notebook bucket access, no static key).
# Mirrors the deployment/ folder. Keep `# secret` values in a secrets manager.
# Full reference: docs/configuration.md, docs/coreweave-bucket-access.md.

# --- Storage: CoreWeave CAIOS via the S3 API ---
MARIMOHUB_STORAGE_BACKEND=s3
MARIMOHUB_STORAGE_S3_BUCKET=orgname-marimohub
MARIMOHUB_STORAGE_S3_ENDPOINT=https://cwobject.com
MARIMOHUB_STORAGE_S3_REGION=us-east-1
MARIMOHUB_STORAGE_S3_ACCESS_KEY_ID=          # secret
MARIMOHUB_STORAGE_S3_SECRET_ACCESS_KEY=      # secret

# --- Compute: CoreWeave Sandboxes ---
MARIMOHUB_COMPUTE_BACKEND=coreweave
MARIMOHUB_COMPUTE_IMAGE=ghcr.io/your-org/marimo-sandbox:latest
MARIMOHUB_COMPUTE_COREWEAVE_API_KEY=         # secret
MARIMOHUB_COMPUTE_SANDBOX_HOSTNAME=sandboxes.example.net

# --- Auth (OIDC) ---
MARIMOHUB_AUTH_BACKEND=oidc
MARIMOHUB_AUTH_OIDC_ISSUER=https://accounts.example.com
MARIMOHUB_AUTH_OIDC_CLIENT_ID=
MARIMOHUB_AUTH_OIDC_CLIENT_SECRET=           # secret
MARIMOHUB_AUTH_OIDC_REDIRECT_URI=https://hub.example.com/api/auth/callback
MARIMOHUB_AUTH_SESSION_SECRET=               # secret (>=32 bytes)
MARIMOHUB_AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# --- Workload Identity Federation (all-or-nothing) ---
MARIMOHUB_WIF_SIGNING_KEY=                    # secret — RSA private key (PKCS8 PEM, or its base64)
MARIMOHUB_WIF_KID=wif-2026-06
MARIMOHUB_WIF_ISSUER_URL=https://hub.example.com
MARIMOHUB_WIF_AUDIENCE=coreweave-object-storage
MARIMOHUB_WIF_BROKER=coreweave
MARIMOHUB_WIF_COREWEAVE_EXCHANGE_URL=https://api.coreweave.com/v1/cwobject/temporary-credentials/oidc/<ORG-ID>
MARIMOHUB_WIF_STORAGE_ENDPOINT=https://cwobject.com
MARIMOHUB_WIF_STORAGE_REGION=us-east-1

# --- Server ---
PORT=3000
MARIMOHUB_RUN_MAINTENANCE=true               # run on exactly ONE replica
