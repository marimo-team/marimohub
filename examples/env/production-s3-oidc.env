# marimohub — common production setup: S3 storage + Modal compute + OIDC login.
# Keep the `# secret` values in a secrets manager, not in this file.
# Full reference: docs/configuration.md and apps/server/.env.example.

# --- Storage (durable; the single source of truth) ---
MARIMOHUB_STORAGE_BACKEND=s3
MARIMOHUB_STORAGE_S3_BUCKET=orgname-marimohub
MARIMOHUB_STORAGE_S3_REGION=us-east-1
MARIMOHUB_STORAGE_S3_ACCESS_KEY_ID=          # secret
MARIMOHUB_STORAGE_S3_SECRET_ACCESS_KEY=      # secret

# --- Compute (kernel sandboxes) ---
MARIMOHUB_COMPUTE_BACKEND=modal
MARIMOHUB_COMPUTE_IMAGE=ghcr.io/your-org/marimo-sandbox:latest
MARIMOHUB_COMPUTE_MODAL_TOKEN_ID=            # secret
MARIMOHUB_COMPUTE_MODAL_TOKEN_SECRET=        # secret
MARIMOHUB_COMPUTE_IDLE_TIMEOUT=20m

# Kernels run untrusted code — serve them from a domain SEPARATE from the app.
MARIMOHUB_COMPUTE_SANDBOX_HOSTNAME=sandboxes.example.net

# --- Auth (OIDC) ---
MARIMOHUB_AUTH_BACKEND=oidc
MARIMOHUB_AUTH_OIDC_ISSUER=https://accounts.example.com
MARIMOHUB_AUTH_OIDC_CLIENT_ID=
MARIMOHUB_AUTH_OIDC_CLIENT_SECRET=           # secret
MARIMOHUB_AUTH_OIDC_REDIRECT_URI=https://hub.example.com/api/auth/callback
MARIMOHUB_AUTH_SESSION_SECRET=               # secret (>=32 bytes)
MARIMOHUB_AUTH_ALLOWED_EMAIL_DOMAINS=example.com   # restrict login; `*` allows all

# --- Server ---
PORT=3000
MARIMOHUB_RUN_MAINTENANCE=true               # run on exactly ONE replica
MARIMOHUB_MAX_SESSIONS_PER_USER=10
