{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marimohub",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-10",
	"compatibility_flags": ["nodejs_compat_v2"],
	// AUTH_MODE: "dev" is a LOCAL-ONLY bypass (authenticates every request as a
	// fixed user). A real deployment MUST set AUTH_MODE=access plus ACCESS_TEAM
	// and ACCESS_AUD. The worker now refuses to start on any other value.
	"vars": {
		// Optional hub branding; see docs/theming.md.
		// "MARIMOHUB_THEME_NAME": "Research Hub",
		// "MARIMOHUB_THEME_PRIMARY_COLOR": "#2563eb",
		// "MARIMOHUB_THEME_SECONDARY_COLOR": "#7c3aed",
		// "MARIMOHUB_THEME_LOGO": "https://hub.example.com/brand/logo.svg",
		// "MARIMOHUB_THEME_LOGO_DARK": "https://hub.example.com/brand/logo-dark.svg",
		// "MARIMOHUB_THEME_FAVICON": "https://hub.example.com/brand/favicon.png",
		// "MARIMOHUB_THEME_PWA_ICON_192": "https://hub.example.com/brand/icon-192.png",
		// "MARIMOHUB_THEME_PWA_ICON_512": "https://hub.example.com/brand/icon-512.png",
		// "MARIMOHUB_THEME_APPLE_TOUCH_ICON": "https://hub.example.com/brand/apple-touch-icon.png",
		"AUTH_MODE": "dev",
		"USER_ID": "user",
		"USER_EMAIL": "user@localhost",
		"R2_BUCKET_NAME": "orgname-marimohub",
		"R2_S3_ENDPOINT": "",
		"SANDBOX_HOSTNAME": "",
		"MARIMOHUB_SANDBOX_AUTH": "off",
	},
	// Serve the prebuilt SPA (built by `pnpm --filter @marimo-hub/web build`).
	"assets": {
		"directory": "../../packages/web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/manifest.webmanifest", "/apple-touch-icon.png"],
	},
	"observability": { "enabled": true },
	"r2_buckets": [{ "binding": "NOTEBOOKS_BUCKET", "bucket_name": "orgname-marimohub" }],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./sandbox.Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 10,
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
	"triggers": {
		// Session maintenance: expire stale heartbeats + reap terminal records.
		"crons": ["*/5 * * * *"],
	},
}
